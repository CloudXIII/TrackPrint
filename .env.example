# Copy to .env (Vite reads .env only):  cp .env.example .env
# Never commit .env — only this file belongs in git.
#
# Default stack = OSRM + Nominatim + Leaflet (CARTO tiles).
# Set VITE_MAP_PROVIDER=googleMaps to drive both adapters, or set the two below.
# Valid provider values: osrm | googleMaps  (not nominatim — geocoding-only).

VITE_ROUTING_PROVIDER=osrm
VITE_GEOCODING_PROVIDER=nominatim

# Required for the default map (Leaflet tiles). Free key:
# https://carto.com/basemaps/apikey/
# Host env + Referer restriction + localhost key: see README.
VITE_CARTO_BASEMAPS_KEY=

# Required only if routing/geocoding provider is googleMaps.
# Enable: Routes + Places (New) + Maps JavaScript + Maps Static (not legacy APIs).
VITE_GOOGLE_MAPS_KEY=
