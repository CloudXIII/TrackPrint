# IMPORTANT: Vite reads .env only — NOT this file.
# Copy to .env and edit there:  cp .env.example .env
#
# Optional unified override for BOTH geocoding and routing adapters.
# Valid values: osrm | googleMaps  (do NOT use nominatim — geocoding-only).
# VITE_MAP_PROVIDER=googleMaps
#
# Provider-specific (used when VITE_MAP_PROVIDER is unset):
# OpenStreetMap stack (default — no API key required):
#   VITE_ROUTING_PROVIDER=osrm
#   VITE_GEOCODING_PROVIDER=nominatim
#
# Google Maps stack (requires VITE_GOOGLE_MAPS_KEY in .env):
#   VITE_ROUTING_PROVIDER=googleMaps
#   VITE_GEOCODING_PROVIDER=googleMaps

VITE_ROUTING_PROVIDER=osrm
VITE_GEOCODING_PROVIDER=nominatim

# Google Cloud API key — put your real key in .env, never commit it here.
# Enable: Routes API + Places API (New) + Maps JavaScript API + Maps Static API.
# Do NOT use legacy Directions/Geocoding APIs.
VITE_GOOGLE_MAPS_KEY=
